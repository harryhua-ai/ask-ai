# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ask_ai
POSTGRES_USER=ask_ai
POSTGRES_PASSWORD=changeme

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_CLASS_NAME=Document

# DeepSeek LLM
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding device
EMBEDDER_DEVICE=auto
# Sync-only automatic CUDA→CPU fallback (on|off)
EMBEDDER_CPU_FALLBACK=on

# Model cache directory (BGE-m3 + bge-reranker-v2-m3 weights)
# Default: <repo>/models/ — models persist across venv/CI/Docker rebuilds
MODEL_CACHE_DIR=models

# GitHub (for GitHubConnector)
GITHUB_TOKEN=your-github-token

# App
ASKAI_API_HOST=0.0.0.0
ASKAI_API_PORT=8000
LOG_LEVEL=INFO

# Security (Task 21)
FASTAPI_DEBUG=false                # 生产保持 false(docs/redoc 关闭)
APP_MODE=dev                       # prod 时 GITHUB_TOKEN 写权限校验严格
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:1313  # 生产改为官网/Wiki 域名
BUDGET_DAILY_REQUESTS=500          # 每日 /api/ask 请求上限
BUDGET_DAILY_TOKENS=2000000        # 每日 LLM 估算 token 上限
