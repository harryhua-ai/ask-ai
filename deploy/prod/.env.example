# ask-ai 生产环境配置(tesla-t4)
# 用法:cp .env.example .env,填实际凭证后 docker compose -f deploy/prod/docker-compose.yml up -d

# ---------- Postgres ----------
POSTGRES_DB=ask_ai
POSTGRES_USER=ask_ai
POSTGRES_PASSWORD=<生产强密码,替换 changeme>

# ---------- 应用(生产)----------
APP_MODE=prod
ASKAI_API_HOST=0.0.0.0
ASKAI_API_PORT=8000
# CORS 白名单(生产,逗号分隔;非 *)。变量名必须为 CORS_ALLOW_ORIGINS
# (backend/main.py 读取;RC-2026-09-01 修正:旧模板 CORS_ORIGINS 是死变量,
#  生产会用默认 localhost 白名单导致跨域全被浏览器拦截)。
# 三个站点来源均已列入(Multi-Site 契约);新增嵌入站点时同步追加。
CORS_ALLOW_ORIGINS=https://www.camthink.ai,https://wiki.camthink.ai,https://store.camthink.ai

# ---------- 安全(生产必填,否则 APP_MODE=prod 启动失败)----------
# JWT 签发 admin token(管理后台登录);生产用强随机值
JWT_SECRET=<openssl rand -hex 32>
# LLM API key 等加密存储密钥(≥32 字节)
ENCRYPTION_KEY=<openssl rand -hex 32>

# ---------- LLM(DeepSeek)----------
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=<生产 deepseek key>
# RC-2026-09-01 修正:v4-pro → v4-flash(08-31 拍板:flash 与生产 DB 一致;
# 旧模板 v4-pro 会在 DB 读取失败回退时引入 ~2x 生成延迟)
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- Embedder / Reranker(GPU)----------
EMBEDDER_DEVICE=cuda
EMBEDDER_BATCH_SIZE=16
EMBEDDER_MAX_LENGTH=1024
MODEL_CACHE_DIR=/models
HF_HOME=/models
TRANSFORMERS_OFFLINE=1

# ---------- Weaviate / Postgres(容器内网络)----------
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_CLASS_NAME=Document
# POSTGRES_DSN 由 compose environment 覆盖(指向 compose 的 postgres 服务)

# ---------- WooCommerce(commercial 数据源)----------
WOOCOMMERCE_STORE_URL=https://www.camthink.ai
WOOCOMMERCE_CONSUMER_KEY=<只读 WooCommerce key>
WOOCOMMERCE_CONSUMER_SECRET=<只读 WooCommerce secret>

# ---------- GitHub(sync 拉代码仓库)----------
# 启动时校验为只读最小权限(生产严格模式阻断启动)
GITHUB_TOKEN=<只读 token>

# ---------- 管理员账户(首次启动创建)----------
# 见 scripts/create_admin_user.py
ADMIN_EMAIL=admin@camthink.ai
ADMIN_PASSWORD=<生产强密码>
